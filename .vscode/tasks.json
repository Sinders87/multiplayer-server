{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Project",
      "type": "shell",
      "command": "cmake -G \"MinGW Makefiles\" -S . -B build && cmake --build build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Build using CMake and MinGW"
    },
    {
      "label": "Run Server",
      "type": "shell",
      "command": "./build/server.exe",
      "group": "none"
    },
    {
      "label": "Run Client",
      "type": "shell",
      "command": "./build/client.exe",
      "group": "none"
    }
  ]
}
